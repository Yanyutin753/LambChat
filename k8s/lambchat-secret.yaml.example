---
# LambChat Secrets
# Copy this file to lambchat-secret.yaml and fill in your values
# DO NOT commit lambchat-secret.yaml to git
apiVersion: v1
kind: Secret
metadata:
  name: lambchat-secrets
  namespace: lambchat
type: Opaque
stringData:
  jwt-secret-key: "YOUR_JWT_SECRET_KEY"
  mcp-encryption-salt: "YOUR_MCP_ENCRYPTION_SALT"
  llm-api-key: "YOUR_LLM_API_KEY"
  anthropic-api-key: "YOUR_ANTHROPIC_API_KEY"
  redis-password: "YOUR_REDIS_PASSWORD"
  postgres-password: "YOUR_POSTGRES_PASSWORD"
  mongodb-username: "YOUR_MONGODB_USERNAME"
  mongodb-password: "YOUR_MONGODB_PASSWORD"
  s3-access-key: "YOUR_S3_ACCESS_KEY"
  s3-secret-key: "YOUR_S3_SECRET_KEY"
  langsmith-api-key: "YOUR_LANGSMITH_API_KEY"
  openviking-api-key: "YOUR_OPENVIKING_API_KEY"
  daytona-api-key: "YOUR_DAYTONA_API_KEY"
  e2b-api-key: "YOUR_E2B_API_KEY"
  # ── Memory System (optional, see docs/zh/env/memory.md) ──
  # ENABLE_MEMORY: "true"
  # NATIVE_MEMORY_EMBEDDING_API_BASE: "https://api.siliconflow.cn"
  # NATIVE_MEMORY_EMBEDDING_API_KEY: "sk-your-siliconflow-key"
  # NATIVE_MEMORY_EMBEDDING_MODEL: "BAAI/bge-m3"
  # NATIVE_MEMORY_EMBEDDING_DIMENSIONS: "1024"
  # ── Qdrant vector index (optional; default mongo. Auto-backfills existing
  #    Mongo embeddings on first start, silently degrades to Mongo on failure) ──
  # NATIVE_MEMORY_VECTOR_BACKEND: "qdrant"
  # NATIVE_MEMORY_QDRANT_URL: "http://127.0.0.1:6333"
  # NATIVE_MEMORY_QDRANT_API_KEY: "your-qdrant-api-key"  # dims must match NATIVE_MEMORY_EMBEDDING_DIMENSIONS
  # NATIVE_MEMORY_MODEL: "glm-5.3-flash"  # fast channel for memory extraction
  # NATIVE_MEMORY_QUERY_CONTEXT_ENABLED: "true"  # A1 injection
  # NATIVE_MEMORY_SELF_EVOLVE_ENABLED: "true"    # requires ENABLE_SCHEDULED_TASK=true
