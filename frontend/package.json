{
  "name": "lambchat-frontend",
  "private": true,
  "version": "2.15.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:panels": "tsx scripts/panel-preview.ts",
    "build": "node ../scripts/run-validation.mjs --shell \"node node_modules/typescript-compiler/bin/tsc -b && vite build\"",
    "lint": "node ../scripts/run-validation.mjs eslint .",
    "preview": "vite preview",
    "brand:assets": "node ../scripts/run-validation.mjs node scripts/generate-branded-assets.mjs",
    "brand:assets:check": "node ../scripts/run-validation.mjs node scripts/generate-branded-assets.mjs --check",
    "packaged:build": "node ../scripts/run-validation.mjs --shell \"pnpm brand:assets && node scripts/build-packaged-frontend.mjs\"",
    "package:desktop": "node ../scripts/run-validation.mjs node scripts/package-desktop.mjs",
    "mobile:build": "pnpm packaged:build",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "pnpm packaged:build && cap sync",
    "mobile:sync:ios": "pnpm packaged:build && cap sync ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "i18n:extract": "tsx scripts/extract-i18n.ts",
    "find-large-files": "tsx scripts/find-large-files.ts",
    "migrate-tests": "tsx scripts/migrate-tests.ts",
    "test": "node ../scripts/run-validation.mjs vitest run",
    "test:watch": "node ../scripts/run-validation.mjs vitest",
    "test:coverage": "node ../scripts/run-validation.mjs vitest run --coverage",
    "test:ui": "node ../scripts/run-validation.mjs vitest --ui",
    "migrate-vitest": "tsx scripts/migrate-node-tests-to-vitest.ts",
    "typecheck": "node ../scripts/run-validation.mjs node node_modules/typescript-compiler/bin/tsc -b --noEmit"
  },
  "dependencies": {
    "@animateicons/react": "0.12.0",
