{
  "name": "lambchat-frontend",
  "private": true,
  "version": "2.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "brand:assets": "node scripts/generate-branded-assets.mjs",
    "brand:assets:check": "node scripts/generate-branded-assets.mjs --check",
    "packaged:build": "pnpm brand:assets && node scripts/build-packaged-frontend.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "mobile:build": "pnpm packaged:build",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "pnpm packaged:build && cap sync",
    "mobile:sync:ios": "pnpm packaged:build && cap sync ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "i18n:extract": "tsx scripts/extract-i18n.ts",
    "find-large-files": "tsx scripts/find-large-files.ts",
    "migrate-tests": "tsx scripts/migrate-tests.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "migrate-vitest": "tsx scripts/migrate-node-tests-to-vitest.ts"
