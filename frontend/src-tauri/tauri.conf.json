{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LambChat",
  "version": "2.8.0",
  "identifier": "com.lambchat.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm packaged:build"
  },
  "app": {
    "windows": [
      {
        "title": "LambChat",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/lambchat-daemon"],
    "resources": ["resources/python/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3REJCNjQ1NTgzN0NGNTkKUldSWnp6ZFlSYmJiWjRHb1lJRFhVOXl5cW93OWlnK0hhS25pdE5lWC9xaVpiL0svTzV0em5ydVIK",
      "endpoints": [
        "https://github.com/Yanyutin753/LambChat/releases/latest/download/latest.json"
      ]
    }
  }
}
